{
  "name": "francocaccia-github-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Franco Caccia's portfolio: one data file, three ways to read it. Logic in C++ (WebAssembly), pages in Astro.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "test": "node scripts/test-cpp.mjs",
    "test:ts": "node --test \"tests/ts/*.test.ts\"",
    "build:world": "node scripts/build-world.mjs",
    "build:icons": "node scripts/make-icons.mjs",
    "check:data": "node scripts/check-data.mjs",
    "fetch:metar": "node scripts/fetch-metar.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "predev": "node scripts/build-wasm.mjs --if-stale",
    "dev": "astro dev",
    "prebuild": "node scripts/build-wasm.mjs --if-stale && node scripts/check-data.mjs",
    "build": "astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/b612": "5.3.0",
    "@fontsource/b612-mono": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@capsizecss/metrics": "4.4.0",
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "typescript": "7.0.2",
    "world-atlas": "2.0.2"
  }
}
