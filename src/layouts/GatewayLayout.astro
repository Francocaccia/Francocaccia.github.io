---
import { fontSets } from '../lib/fonts';
import Base from './Base.astro';

const fontSet = fontSets.gateway;

interface Props {
  title: string;
  description: string;
  current?: 'gateway' | 'summary';
  noindex?: boolean;
}

const { title, description, current = 'gateway', noindex = false } = Astro.props;
---

<Base fonts={fontSet.preload} fontCss={fontSet.css} title={title} description={description} current={current} theme="gateway" noindex={noindex}>
  <slot name="head" slot="head" />
  <slot />
</Base>
