---
// Aviation view (design A1): the whole portfolio as an ICAO flight plan form, "filed" on paper.
// Every field holds real portfolio data from site.json. The route, METAR and TAF are pre-rendered by the
// C++ core at build time, so the page is complete without JavaScript. src/scripts/aviation.ts adds the live
// report ages, the paste box and the crosswind calculator, and bot-tiles.ts fills the performance tiles.
import AviationLayout from '../../layouts/AviationLayout.astro';
import BotTiles from '../../components/BotTiles.astro';
import { site, real, opt } from '../../lib/site';
import { coreCall } from '../../lib/core';
import { stationWeather, utcStamp, ageText, STALE_MS } from '../../lib/weather';

interface Metar {
  ok: boolean;
  html: string;
  category: string;
  wind: { present: boolean; calm: boolean; variable: boolean; dir: number | null; speedKt: number | null; gustKt: number | null };
}
interface RouteResult {
  svg: string;
  legs: { from: string; to: string; nm: number; km: number; course: number }[];
  totalNm: number;
}
interface TafResult {
  ok: boolean;
  html: string;
  timeline: string;
  error?: string;
}

const now = Date.now();
const av = site.aviation;
const bot = site.bot;
const filedOn = new Date(now).toISOString().slice(0, 10);

// --- Route (items 13, 15, 16) ----------------------------------------------------------------
const routeOf = (width: number, id: string) => coreCall<RouteResult>('geo.route', { airports: site.airports, width, height: width, idPrefix: id });
const routeWide = await routeOf(560, 'fca-w');
const routeNarrow = await routeOf(340, 'fca-n');
const airports = Object.fromEntries(site.airports.map((a) => [a.icao, a]));
const [departure, ...rest] = site.airports;
const destination = rest[rest.length - 1];
const routeString = site.airports.map((a) => a.icao).join(' DCT ');
const fmtLat = (v: number) => `${Math.abs(v).toFixed(2)}${v >= 0 ? 'N' : 'S'}`;
const fmtLon = (v: number) => `${Math.abs(v).toFixed(2)}${v >= 0 ? 'E' : 'W'}`;
const course = (c: number) => `${String(Math.round(c) % 360).padStart(3, '0')}`;
const nm = (v: number) => Math.round(v).toLocaleString('en-US');

// --- Weather briefing (attached) ---------------------------------------------------------------
const stations = await Promise.all(
  ['SABE', 'KABE'].map(async (icao) => {
    const wx = stationWeather(icao);
    const decoded = await coreCall<Metar>('metar.decode', { raw: wx.raw, observedAt: utcStamp(wx.observedAt) });
    const age = now - Date.parse(wx.observedAt);
    return { ...wx, decoded, age, stale: age > STALE_MS, name: airports[icao].name };
  }),
);
const windByStation = Object.fromEntries(stations.map((s) => [s.icao, s.decoded.wind]));

// --- TAF (attached) ----------------------------------------------------------------------------
const tafOf = (width: number, id: string) => coreCall<TafResult>('taf.decode', { raw: av.tafSample.raw, monthDays: av.tafSample.monthDays, width, idPrefix: id });
const tafWide = await tafOf(720, 'fct-w');
const tafNarrow = await tafOf(360, 'fct-n');

// --- Projects, experience, licenses -------------------------------------------------------------
const [flagship, ...otherProjects] = site.projects;
const statusWord: Record<string, string> = { live: 'LIVE', shipped: 'SHIPPED', next: 'UP NEXT', planned: 'PLANNED' };
const certStatus: Record<string, string> = { active: 'ACTIVE', 'in-progress': 'IN PROGRESS', complete: 'COMPLETE' };
const flightHours = site.certifications.map((c) => opt(c, 'detail')).find((d) => /flight hours/i.test(d));
const email = real(site.email);
const resume = real(site.resume);
---

<AviationLayout
  title="Aviation view"
  description={`${site.name}: aviation view with a route map, METAR and TAF decoders, a crosswind calculator and a pilot card.`}
>
  <div class="wrap av" data-av data-winds={JSON.stringify(windByStation)} data-examples={JSON.stringify(av.examples)}>
    <article class="sheet" aria-labelledby="title">
      <!-- Header -->
      <header class="sheet-head">
        <p class="cap">Flight plan · ICAO format · IFR</p>
        <h1 id="title">{site.name}</h1>
        <p class="lead">{site.positioning} {site.openTo}</p>
        <p class="stamp">
          <span aria-hidden="true">FILED / {filedOn}</span>
          <span class="visually-hidden">Filed on {filedOn}</span>
        </p>
      </header>

      <!-- Items 7 and 8 -->
      <div class="grid">
        <div class="cell c6">
          <p class="lbl"><span class="no">7</span> Aircraft identification</p>
          <p class="val upper">{site.name}</p>
        </div>
        <div class="cell c3">
          <p class="lbl"><span class="no">8</span> Flight rules</p>
          <p class="val"><span class="code">I</span> IFR</p>
        </div>
        <div class="cell c3">
          <p class="lbl"><span class="no">8</span> Type of flight</p>
          <p class="val"><span class="code">G</span> GENERAL</p>
        </div>
        <div class="cell c12">
          <p class="lbl"><span class="no">RMK/</span> Remarks</p>
          <p class="val small">PAPER TRADING ONLY. NOTHING HERE IS INVESTMENT ADVICE.</p>
        </div>

        <!-- Item 10 -->
        <div class="cell c12">
          <p class="lbl"><span class="no">10</span> Equipment and capability</p>
          <ul class="chips">
            {site.technicalSkills.map((t) => <li class="chip">{t}</li>)}
          </ul>
        </div>

        <!-- Items 13, 15, 16 -->
        <div class="cell c4">
          <p class="lbl"><span class="no">13</span> Departure aerodrome</p>
          <p class="val">{departure.icao}</p>
          <p class="sub">{departure.name}<br />{departure.role.toUpperCase()}</p>
        </div>
        <div class="cell c8">
          <p class="lbl"><span class="no">15</span> Route</p>
          <p class="val route">{routeString}</p>
          <div class="scroll" tabindex="0" role="region" aria-label="Route legs table">
            <table class="legs">
              <caption>Great-circle legs (haversine). Course is the initial true course.</caption>
              <thead>
                <tr>
                  <th scope="col">Leg</th>
                  <th scope="col" class="num">Distance</th>
                  <th scope="col" class="num">True course</th>
                </tr>
              </thead>
              <tbody>
                {
                  routeWide.legs.map((l) => (
                    <tr>
                      <th scope="row">{l.from} to {l.to}</th>
                      <td class="num">{nm(l.nm)} NM</td>
                      <td class="num">{course(l.course)}°</td>
                    </tr>
                  ))
                }
                <tr class="total">
                  <th scope="row">Total route length</th>
                  <td class="num">{nm(routeWide.totalNm)} NM</td>
                  <td></td>
                </tr>
              </tbody>
            </table>
          </div>
          <ul class="aprts">
            {
              site.airports.map((a) => (
                <li>
                  <span class="code">{a.icao}</span> {a.name} <span class="muted">({a.role}) {fmtLat(a.lat)} {fmtLon(a.lon)}, approx.</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="cell c4">
          <p class="lbl"><span class="no">16</span> Destination aerodrome</p>
          <p class="val">{destination.icao}</p>
          <p class="sub">{destination.name}<br />{destination.role.toUpperCase()}</p>
        </div>
        <div class="cell c8">
          <p class="lbl">Route chart</p>
          <div class="rv map">
            <div class="rv-wide" set:html={routeWide.svg} />
            <div class="rv-narrow" set:html={routeNarrow.svg} />
          </div>
        </div>
      </div>

      <!-- Item 18: projects -->
      <h2 class="band"><span class="no">18</span> Other information · Projects</h2>
      <div class="grid">
        <div class="cell c8">
          <p class="lbl"><span class="no">PRJ/{flagship.tag}</span></p>
          <h3 class="title">{flagship.name}</h3>
          <p class="status">
            <span class={`st st-${flagship.status}`}>{statusWord[flagship.status]}</span> {flagship.statusLabel}
            {opt(flagship, 'period') && <span class="muted">· {opt(flagship, 'period').toUpperCase()}</span>}
          </p>
          <p class="prose">{flagship.summary}</p>
          <BotTiles class="av-tiles" />
          <h4 class="lbl-sub">Policy bands, share of the portfolio</h4>
          <ul class="bands">
            {
              bot.policyBands.map((b) => (
                <li>
                  <span class="band-name">{b.label}</span>
                  <span class="band-track" role="img" aria-label={`${b.label} policy range: ${b.min} to ${b.max} percent of the portfolio`}>
                    <span class="band-fill" style={`left:${b.min}%;width:${b.max - b.min}%`}></span>
                  </span>
                  <span class="band-val">{b.min}–{b.max}%</span>
                </li>
              ))
            }
          </ul>
          <p class="stack"><span class="lbl-inline">STACK/</span> {flagship.stack.join(' ')}</p>
          {flagship.repo && <p><a href={flagship.repo} aria-label={`GitHub repository for ${flagship.name}`}>GitHub repository</a></p>}
        </div>
        <div class="cell c4">
          <p class="lbl"><span class="no">RMK/</span> Limits in code</p>
          <ol class="limits">
            {bot.riskControls.map((r) => <li>{r}</li>)}
          </ol>
        </div>
        {
          otherProjects.map((p) => (
            <div class="cell c4">
              <p class="lbl"><span class="no">PRJ/{p.tag}</span></p>
              <h3 class="title small-title">{p.name}</h3>
              <p class="status">
                <span class={`st st-${p.status}`}>{statusWord[p.status]}</span> {p.statusLabel}
                {opt(p, 'period') && <span class="muted">· {opt(p, 'period').toUpperCase()}</span>}
              </p>
              <p class="prose">{p.summary}</p>
              <p class="stack"><span class="lbl-inline">STACK/</span> {p.stack.join(' ')}</p>
              {
                p.repo ? (
                  <p><a href={p.repo} aria-label={`GitHub repository for ${p.name}`}>GitHub repository</a></p>
                ) : (
                  <p class="muted">NO PUBLIC REPO</p>
                )
              }
            </div>
          ))
        }
      </div>

      <!-- Item 18: experience -->
      <h2 class="band"><span class="no">18</span> Other information · Experience</h2>
      <div class="grid">
        {
          site.experience.map((e) => (
            <div class="cell c4">
              <p class="lbl"><span class="no">EXP/{e.tag}</span></p>
              <p class="when">{e.start.toUpperCase()} – {e.end.toUpperCase()}</p>
              <h3 class="title small-title">{e.role}</h3>
              <p class="org">{e.org}{opt(e, 'place') && `, ${opt(e, 'place')}`}</p>
              <p class="prose">{e.description}</p>
            </div>
          ))
        }
      </div>

      <!-- Item 19 -->
      <h2 class="band"><span class="no">19</span> Supplementary information</h2>
      <div class="grid">
        <div class="cell c4">
          <p class="lbl"><span class="no">19</span> Pilot in command</p>
          <p class="val upper">{site.name}</p>
          {flightHours && <p class="sub">TOTAL TIME {flightHours.toUpperCase()}</p>}
        </div>
        <div class="cell c8">
          <p class="lbl"><span class="no">19</span> Licenses and ratings</p>
          <ul class="licenses">
            {
              site.certifications.map((c) => (
                <li>
                  <span class={`st st-${c.status}`}>{certStatus[c.status]}</span>
                  <span>
                    {c.name}{'issuer' in c && ` (${c.issuer})`}
                    {opt(c, 'detail') && <span class="muted"> · {opt(c, 'detail')}</span>}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="cell c4">
          <p class="lbl"><span class="no">19</span> Languages</p>
          <ul class="plain">
            {site.languages.map((l) => <li><span class="code">{l.name.toUpperCase()}</span> <span class="muted">{l.level}</span></li>)}
          </ul>
        </div>
        <div class="cell c8">
          <p class="lbl"><span class="no">19</span> Education</p>
          <ul class="plain">
            {
              site.education.map((e) => (
                <li>
                  <strong>{e.degree}</strong>, {e.school}{opt(e, 'place') && `, ${opt(e, 'place')}`} <span class="muted">· {e.period}</span>
                </li>
              ))
            }
          </ul>
          <p class="sub">RELEVANT COURSEWORK: {site.coursework.join(', ').toUpperCase()}.</p>
        </div>
      </div>

      <!-- Attachment: weather briefing -->
      <h2 class="band"><span class="no">ATT</span> Attached · Weather briefing (METAR)</h2>
      <div class="grid">
        {
          stations.map((s) => (
            <article class="cell c6 station" aria-labelledby={`st-${s.icao}`}>
              <h3 class="lbl" id={`st-${s.icao}`}>
                <span class="no">{s.icao}</span> {s.name}
              </h3>
              <p class="obs" data-observed={s.observedAt} data-sample={String(s.sample)} data-state={s.stale ? 'stale' : 'fresh'}>
                <span>Observed {utcStamp(s.observedAt)}.</span>
                <span data-age>{s.stale ? `Older than 6 hours when built (${ageText(s.age)}).` : `${ageText(s.age)} old when built.`}</span>
                {s.sample && <span class="flag flag-sample">Sample data</span>}
                <span class="flag flag-stale" data-stale-flag hidden={!s.stale}>Stale</span>
              </p>
              <div set:html={s.decoded.html} />
              <p class="src">
                Source: {s.sample ? 'sample in the site data (a format demo, not a live report)' : `${s.source}, snapshot ${utcStamp(s.snapshotAt ?? s.observedAt)}`}.
                Hover or focus a group to see what it means.
              </p>
            </article>
          ))
        }
      </div>

      <!-- Attachment: TAF -->
      <h2 class="band"><span class="no">ATT</span> Attached · Forecast decoder (TAF) <span class="flag flag-sample">{av.tafSample.label}</span></h2>
      <div class="grid">
        <div class="cell c12">
          <p class="prose">
            Every change group (FM, BECMG, TEMPO, PROB30 and PROB40) is placed on the timeline and colored by the flight category it would give.
            This forecast is a made-up sample to show the format; it is not a real forecast.
          </p>
          <ul class="legend" aria-label="Flight category key">
            <li><span class="cat cat-vfr">VFR</span> ceiling above 3,000 ft and visibility above 5 SM</li>
            <li><span class="cat cat-mvfr">MVFR</span> 1,000 to 3,000 ft or 3 to 5 SM</li>
            <li><span class="cat cat-ifr">IFR</span> 500 to under 1,000 ft or 1 to under 3 SM</li>
            <li><span class="cat cat-lifr">LIFR</span> under 500 ft or under 1 SM</li>
          </ul>
          <div class="rv timeline">
            <div class="rv-wide" set:html={tafWide.timeline} />
            <div class="rv-narrow" set:html={tafNarrow.timeline} />
          </div>
          <div set:html={tafWide.html} />
        </div>
      </div>

      <!-- Attachment: tools -->
      <h2 class="band"><span class="no">ATT</span> Attached · Tools</h2>
      <div class="grid">
        <section class="cell c12" aria-labelledby="paste-h" data-paste>
          <h3 class="lbl" id="paste-h"><span class="no">TOOL</span> Paste your own METAR or TAF</h3>
          <p class="sub">DECODED IN YOUR BROWSER. NOTHING IS SENT ANYWHERE.</p>
          <form class="paste-form" data-paste-form>
            <label for="paste-in">Report text</label>
            <textarea
              id="paste-in"
              rows="3"
              spellcheck="false"
              autocapitalize="characters"
              autocomplete="off"
              placeholder="KABE 181451Z 00000KT 10SM CLR 09/M01 A3062"
              disabled
              data-paste-input></textarea>
            <div class="actions">
              <button type="submit" class="btn" disabled data-paste-go>Decode</button>
              <button type="button" class="btn btn-quiet" disabled data-paste-clear>Clear</button>
            </div>
          </form>
          <p class="examples-h" id="examples-h">Try an example</p>
          <ul class="examples" aria-labelledby="examples-h">
            {av.examples.map((e, i) => <li><button type="button" class="chip-btn" disabled data-example={i}>{e.label}</button></li>)}
          </ul>
          <div class="paste-out" role="region" aria-live="polite" aria-label="Decoded result" data-paste-out>
            <p class="muted">Paste a report above, or pick an example. This tool needs JavaScript.</p>
          </div>
        </section>

        <section class="cell c12" aria-labelledby="xw-h" data-xw>
          <h3 class="lbl" id="xw-h"><span class="no">TOOL</span> Crosswind calculator</h3>
          <form class="xw-form" data-xw-form>
            <div class="fields">
              <label>Wind source
                <select disabled data-xw-source>
                  <option value="KABE">KABE METAR (current)</option>
                  <option value="SABE">SABE METAR (current)</option>
                  <option value="manual">Enter my own</option>
                </select>
              </label>
              <label>Wind from, degrees true
                <input type="number" inputmode="numeric" min="0" max="360" step="1" disabled data-xw="dir" />
              </label>
              <label>Speed, knots
                <input type="number" inputmode="numeric" min="0" max="200" step="1" disabled data-xw="speed" />
              </label>
              <label>Gust, knots (optional)
                <input type="number" inputmode="numeric" min="0" max="300" step="1" disabled data-xw="gust" />
              </label>
              <label>Runway
                <input type="text" inputmode="text" maxlength="3" placeholder="for example 24" autocomplete="off" spellcheck="false" disabled data-xw="runway" />
              </label>
              <label>Magnetic variation, degrees (east +, optional)
                <input type="number" inputmode="decimal" min="-90" max="90" step="0.1" disabled data-xw="variation" />
              </label>
            </div>
          </form>
          <div class="xw-out" role="region" aria-live="polite" aria-label="Crosswind result" data-xw-out>
            <p class="muted">Enter a runway number to see the components. This tool needs JavaScript.</p>
          </div>
          <p class="sub">
            METAR WINDS ARE GIVEN RELATIVE TO TRUE NORTH, WHILE RUNWAY NUMBERS ARE MAGNETIC HEADINGS. LEAVE THE VARIATION AT 0 FOR A ROUGH FIGURE, OR ENTER THE
            LOCAL MAGNETIC VARIATION (EAST POSITIVE) TO CORRECT IT. ALWAYS USE THE RUNWAY'S PUBLISHED HEADING AND CURRENT OFFICIAL DATA FOR REAL FLYING.
          </p>
        </section>
      </div>

      <!-- Attachment: habits -->
      <h2 class="band"><span class="no">ATT</span> Attached · Checklists, minimums, briefings</h2>
      <div class="grid">
        {
          av.meetsCode.map((m) => (
            <div class="cell c4">
              <p class="lbl"><span class="no">{m.habit.toUpperCase()}</span></p>
              <p class="prose"><em>In the cockpit.</em> {m.inFlight}</p>
              <p class="prose"><em>In the trading bot.</em> {m.inCode}</p>
            </div>
          ))
        }
      </div>

      <!-- Footer -->
      <footer class="sheet-foot">
        <p class="lbl"><span class="no">FILED BY</span></p>
        <p class="links">
          <a href={site.links.github}>GitHub</a>
          <a href={site.links.linkedin}>LinkedIn</a>
          {email && <a href={`mailto:${email}`}>{email}</a>}
          {resume ? <a href={resume}>Resume (PDF)</a> : <span class="todo">resume: TODO</span>}
        </p>
        <p class="disclaimer">{site.footer}</p>
      </footer>
    </article>
  </div>
</AviationLayout>

<script>
  import '../../scripts/aviation';
  import '../../scripts/bot-tiles';
</script>
