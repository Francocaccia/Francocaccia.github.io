---
// Terminal view (design T1): an amber phosphor window with a real shell over a virtual filesystem
// generated from site.json. The C++ engine pre-renders the first screen (projects, stats, experience)
// and the <noscript> copy at build time, and runs again in the browser (WebAssembly) for everything else.
import TerminalLayout from '../../layouts/TerminalLayout.astro';
import TermLines from '../../components/TermLines.astro';
import { site } from '../../lib/site';
import { coreCall } from '../../lib/core';
import { enabledModes } from '../../config';
import { stationWeather } from '../../lib/weather';

type Lines = { t: string; k?: string; h?: string; c?: string }[][];

const modes = enabledModes()
  .filter((m) => m.id !== 'terminal')
  .map((m) => m.id);

// Reports `metar` can decode: the two airports on the route (latest snapshot) and the format-demo
// examples from the Aviation view (labeled sample). One report per airport.
const metars: Record<string, { raw: string; observedAt: string; sample: boolean }> = {};
for (const icao of ['SABE', 'KABE']) {
  const w = stationWeather(icao);
  metars[icao] = { raw: w.raw, observedAt: w.observedAt, sample: w.sample };
}
for (const example of site.aviation.examples) {
  const station = example.raw.split(' ')[0];
  if (/^[A-Z]{4}$/.test(station) && !metars[station]) metars[station] = { raw: example.raw, observedAt: '', sample: true };
}

const init = await coreCall<{ files: { path: string; content: string }[] }>('term.init', { site, modes, metars, files: true });
const run = (line: string) => coreCall<{ lines: Lines }>('term.exec', { line, cwd: '~', history: [line], now: 0 });
const projects = await run('projects');
const experience = await run('experience');
const stats = await coreCall<{ lines: Lines }>('term.stats', { placeholder: true, pad: true, trackingSince: site.bot.trackingSince });

const bot = site.bot;
const tryThese = [
  { cmd: 'help', why: 'every command, explained' },
  { cmd: 'cat README.md', why: 'the whole portfolio in one file' },
  { cmd: 'projects', why: 'what I have built' },
  { cmd: 'experience', why: 'where I have worked' },
  { cmd: 'stats', why: 'the trading bot' },
  { cmd: 'skills', why: 'tools I use' },
  { cmd: 'licenses', why: 'pilot licenses' },
  { cmd: 'metar kabe', why: 'decode real weather' },
  { cmd: 'grep -i python', why: 'search everything' },
  { cmd: 'open github', why: 'get a link' },
  { cmd: 'mode aviation', why: 'switch view' },
  { cmd: 'sudo hire franco', why: 'try it' },
];
const cheats = [
  ['ls', 'list files in this folder'],
  ['cd <folder>', 'go in (cd .. goes back)'],
  ['cat <file>', 'read a file'],
  ['Tab', 'finish a name'],
  ['Esc, Tab', 'leave the prompt'],
  ['Up / Down', 'earlier commands'],
  ['clear', 'wipe the screen'],
];
const jsonForScript = JSON.stringify(site).replace(/</g, '\\u003c');
const prompt = 'visitor@portfolio:~$';
---

<TerminalLayout
  title="Terminal view"
  description={`${site.name}: an interactive shell in the browser. Type help, or click a command, to read about projects, experience, skills and contact details.`}
>
  <noscript><style>.try, .try-h { display: none; }</style></noscript>
  <div class="wrap">
    <div
      class="term-layout"
      data-term
      data-modes={modes.join(',')}
      data-metars={JSON.stringify(metars)}
      data-api-base={bot.apiBase}
      data-stats-path={bot.statsPath}
      data-history-path={bot.historyPath}
      data-history-live={String(bot.historyLive)}
      data-timeout={bot.timeoutMs}
      data-tracking-since={bot.trackingSince}
    >
      <section class="term" aria-label="Interactive terminal">
        <div class="term-bar" aria-hidden="true">
          <span class="dots"><i></i><i></i><i></i></span>
          <span class="term-title" data-title>visitor@portfolio: ~</span>
        </div>
        <header class="term-banner">
          <h1 class="term-name">{site.name}</h1>
          <p class="term-pos">{site.positioning}</p>
          <p class="term-open">{site.openTo}</p>
        </header>
        <div class="term-screen" role="log" aria-live="polite" aria-relevant="additions" aria-label="Terminal output" tabindex="0" data-screen>
          <div class="term-line term-echo"><span class="ps">{prompt}</span> projects</div>
          <TermLines lines={projects.lines} />
          <div class="term-line term-echo"><span class="ps">{prompt}</span> stats</div>
          <div data-stats-block><TermLines lines={stats.lines} /></div>
          <div class="term-line term-echo"><span class="ps">{prompt}</span> experience</div>
          <TermLines lines={experience.lines} />
        </div>
        <form class="term-input" data-form autocomplete="off">
          <label class="ps" for="term-cmd" data-ps>{prompt}</label>
          <input
            id="term-cmd"
            name="command"
            type="text"
            autocapitalize="off"
            autocomplete="off"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="go"
            inputmode="text"
            maxlength="1000"
            aria-describedby="term-hint"
            disabled
            data-input
          />
          <button type="submit" class="run" data-run-button>run</button>
        </form>
        <div class="term-keys" data-keys>
          <button type="button" data-key="tab">Tab</button>
          <button type="button" data-key="up" aria-label="Up: previous command">Up</button>
          <button type="button" data-key="down" aria-label="Down: next command">Down</button>
          <button type="button" data-key="clear">Clear</button>
          <span id="term-hint" class="term-hint">Type help, then press Enter. Tab completes a name. Esc, then Tab, leaves the prompt.</span>
        </div>
      </section>

      <aside class="term-panel" aria-labelledby="panel-h">
        <h2 id="panel-h">How this works</h2>
        <p class="panel-lead">
          A real shell, made for reading. Type a command and press Enter, or click anything green. Everything it shows comes from the
          same data as the other views, and nothing here can break.
        </p>

        <h2 class="try-h">Try these</h2>
        <ul class="try">
          {
            tryThese.map((t) => (
              <li>
                <button type="button" class="try-btn" data-run={t.cmd}>
                  <span class="try-cmd">{t.cmd}</span>
                  <span class="try-why">{t.why}</span>
                </button>
              </li>
            ))
          }
        </ul>

        <details class="cheat" data-cheat>
          <summary>Cheat sheet</summary>
          <dl>
            {
              cheats.map(([k, v]) => (
                <>
                  <dt><code>{k}</code></dt>
                  <dd>{v}</dd>
                </>
              ))
            }
          </dl>
        </details>
      </aside>
    </div>

    <noscript>
      <section class="static" aria-labelledby="static-h">
        <h2 id="static-h">Same facts, as plain text</h2>
        <p>The interactive shell needs JavaScript. These are the files it would show.</p>
        {
          init.files.map((f) => (
            <>
              <h3>{f.path}</h3>
              <pre>{f.content}</pre>
            </>
          ))
        }
        <p>
          Links: <a href={site.links.github}>GitHub</a>, <a href={site.links.linkedin}>LinkedIn</a>.
        </p>
      </section>
    </noscript>

    <script type="application/json" id="term-site" set:html={jsonForScript} />
  </div>
</TerminalLayout>

<script>
  import '../../scripts/terminal';
</script>
