---
// Plain "Quick view": the same facts, no theme. Always available, readable without JavaScript.
import GatewayLayout from '../layouts/GatewayLayout.astro';
import { site, real, opt } from '../lib/site';

const email = real(site.email);
const resume = real(site.resume);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  description: `${site.positioning} ${site.openTo}`,
  url: 'https://francocaccia.github.io/',
  address: { '@type': 'PostalAddress', addressRegion: 'Pennsylvania', addressCountry: 'US' },
  sameAs: [site.links.github, site.links.linkedin],
};
const personJson = JSON.stringify(person).replace(/</g, '\\u003c');
---

<GatewayLayout
  title="Summary and resume"
  description={`${site.name}: ${site.positioning}`}
  current="summary"
>
  <script type="application/ld+json" slot="head" set:html={personJson} />
  <div class="wrap">
    <h1>{site.name}</h1>
    <p>{site.location}</p>
    <p>{site.positioning} {site.openTo}</p>

    <p>
      <a href={site.links.github}>GitHub</a> ·
      <a href={site.links.linkedin}>LinkedIn</a> ·
      {email ? <a href={`mailto:${email}`}>{email}</a> : <span class="todo">email: TODO</span>} ·
      {resume ? <a href={resume}>Resume (PDF)</a> : <span class="todo">resume: TODO</span>}
    </p>

    <h2>Projects</h2>
    <ul>
      {
        site.projects.map((p) => (
          <li>
            <strong>{p.repo ? <a href={p.repo}>{p.name}</a> : p.name}</strong> ({p.statusLabel}{opt(p, 'period') && `, ${opt(p, 'period')}`}). {p.summary}{' '}
            <em>Stack: {p.stack.join(', ')}.</em>
          </li>
        ))
      }
    </ul>

    <h2>Experience</h2>
    <ul>
      {
        site.experience.map((e) => (
          <li>
            <strong>{e.role}</strong>, {e.org}{opt(e, 'place') && `, ${opt(e, 'place')}`} ({e.start} to {e.end}). {e.description}
          </li>
        ))
      }
    </ul>

    <h2>Education</h2>
    <ul>
      {
        site.education.map((e) => (
          <li>
            {e.degree}, {e.school}{opt(e, 'place') && `, ${opt(e, 'place')}`}{' '}
            {e.period.startsWith('TODO') ? <span class="todo">years: TODO</span> : `(${e.period})`}
          </li>
        ))
      }
    </ul>

    <p><strong>Relevant coursework:</strong> {site.coursework.join(', ')}.</p>

    <h2>Technical skills</h2>
    <p>{site.technicalSkills.join(', ')}.</p>

    <h2>Certifications</h2>
    <ul>
      {
        site.certifications.map((c) => (
          <li>
            {c.name}{'issuer' in c ? ` (${c.issuer})` : ''}: {c.status.replace('-', ' ')}{opt(c, 'detail') && `, ${opt(c, 'detail')}`}
          </li>
        ))
      }
    </ul>

    <h2>Languages</h2>
    <p>{site.languages.map((l) => `${l.name} (${l.level})`).join(', ')}</p>
  </div>
</GatewayLayout>
