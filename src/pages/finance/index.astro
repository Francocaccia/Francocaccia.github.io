---
// Finance view (design F4): an annual letter. Everything is static HTML. The chart shows labeled
// illustrative data until the bot's history feed is live; src/scripts/finance-live.ts upgrades it in the
// browser and adds the day-by-day inspection, and bot-tiles.ts fills the four performance tiles.
import FinanceLayout from '../../layouts/FinanceLayout.astro';
import BotTiles from '../../components/BotTiles.astro';
import { site, real, opt } from '../../lib/site';
import { illustrativeChart, type Variant } from '../../lib/charts';

const bot = site.bot;
const fin = site.finance;
const year = bot.trackingSince.slice(0, 4);
const [atb, ...others] = site.projects;
const quote = fin.quote;
const controls = bot.riskControls.filter((r) => r !== quote);

// Three chart sizes, one shown at a time by CSS (phone, tablet, desktop).
const variants: Variant[] = ['narrow', 'mid', 'wide'];
const charts = Object.fromEntries(await Promise.all(variants.map(async (v) => [v, await illustrativeChart(v)]))) as Record<
  Variant,
  Awaited<ReturnType<typeof illustrativeChart>>
>;
const last = charts.wide.points[charts.wide.points.length - 1];

// Skills by where they were used (quiet list, not a heatmap).
const built = new Set(
  [...site.projects.filter((p) => p.status === 'live' || p.status === 'shipped').map((p) => p.id), ...site.experience.map((e) => e.id)],
);
const skillGroups = [...new Set(site.skills.map((s) => s.group))].map((group) => ({
  group,
  skills: site.skills
    .filter((s) => s.group === group)
    .map((s) => ({ name: s.name, count: s.usedIn.filter((id) => built.has(id)).length }))
    .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name)),
}));

const statusWord: Record<string, string> = { live: 'Live', shipped: 'Shipped', next: 'Up next', planned: 'Planned' };
const certStatus: Record<string, string> = { active: 'active', 'in-progress': 'in progress', complete: 'complete' };
const email = real(site.email);
const resume = real(site.resume);
const licenseLine = site.certifications
  .map((c) => `${c.name}${'issuer' in c ? ` (${c.issuer})` : ''}, ${certStatus[c.status]}`)
  .join(' · ');
const pad = (n: number) => String(n).padStart(2, '0');
---

<FinanceLayout
  title="Finance view"
  description={`${site.name}: an annual letter. A paper-trading bot against the S&P 500 and a 60/40 portfolio, the projects shipped and the record behind them. Paper trading only.`}
>
  <script is:inline>
    document.documentElement.classList.add('js');
  </script>
  <div
    class="wrap letter"
    data-finance
    data-api-base={bot.apiBase}
    data-history-path={bot.historyPath}
    data-history-live={String(bot.historyLive)}
    data-timeout={bot.timeoutMs}
  >
    <!-- Masthead -->
    <p class="mast">
      <span>{site.name}</span>
      <span>Annual letter · {year}</span>
      <span>Paper trading only</span>
    </p>

    <!-- Hero -->
    <header class="hero">
      <h1 class="headline">
        <span class="visually-hidden">{site.name}: </span>
        <span class="w">{fin.headline[0]}</span>
        <span class="w">{fin.headline[1]}</span>
        <span class="w accent">{fin.headline[2]}</span>
      </h1>
      <div class="hero-text">
        <p>{fin.salutation} {fin.letter}</p>
        <p>{site.positioning} {site.openTo}</p>
      </div>
    </header>

    <!-- Numbers -->
    <ul class="numbers" aria-label="By the numbers">
      {
        site.highlights.map((h) => (
          <li>
            <span class="n">{h.value}</span>
            <span class="l">{h.label}</span>
          </li>
        ))
      }
    </ul>

    <!-- Chapter 01 -->
    <section class="chapter" aria-labelledby="c1">
      <p class="kicker">Chapter 01</p>
      <h2 id="c1" class="chap">The bot</h2>

      <div class="two">
        <div>
          <p class="status-line">
            <span class="status status-{atb.status}">{statusWord[atb.status]}</span>
            <span>{atb.name} · {atb.statusLabel}</span>
            {opt(atb, 'period') && <span>· {opt(atb, 'period')}</span>}
          </p>
          <p class="dropcap">{atb.summary}</p>
          <ul class="stack" aria-label="Stack">
            {atb.stack.map((s) => <li>{s}</li>)}
          </ul>
          {
            atb.repo && (
              <p class="mini-link">
                <a href={atb.repo} aria-label={`Source on GitHub: ${atb.name}`}>Source on GitHub</a>
              </p>
            )
          }
        </div>
        <figure class="pull">
          <blockquote>
            <p>{quote}</p>
          </blockquote>
          <figcaption>Risk control {bot.riskControls.indexOf(quote) + 1} of {bot.riskControls.length}. The others are in the notes below.</figcaption>
        </figure>
      </div>

      <h3 class="sub">How it has done so far</h3>
      <BotTiles class="tiles-f4" />

      <h3 class="sub">Policy bands, the share of the portfolio each may hold</h3>
      <ul class="bands">
        {
          bot.policyBands.map((b) => (
            <li>
              <span class="band-name">{b.label}</span>
              <span class="band-track" role="img" aria-label={`${b.label} policy range: ${b.min} to ${b.max} percent of the portfolio`}>
                <span class="band-fill" style={`left:${b.min}%;width:${b.max - b.min}%`}></span>
              </span>
              <span class="band-val">{b.min}–{b.max}%</span>
            </li>
          ))
        }
      </ul>

      <!-- Figure 1 -->
      <figure class="figure" data-fig data-mix="on" id="figure-1">
        <figcaption class="cap">Figure 1 · The bot, day by day, against the S&P 500 · Indexed to 100</figcaption>
        <p class="sample" role="status" data-chart-notice data-state="static">
          <span data-notice-text>Illustrative data, not real results. The bot's history feed is not published yet, so this chart shows a made-up series that starts at 100.</span>
        </p>
        <div class="fig-bar">
          <ul class="key" aria-label="Chart key">
            <li><i class="k-candle" aria-hidden="true"></i>Bot, daily candle (filled = up day, hollow = down day)</li>
            <li><i class="k-spy" aria-hidden="true"></i>S&P 500 (SPY)</li>
            <li class="key-mix"><i class="k-mix" aria-hidden="true"></i>60/40 (SPY/AGG)</li>
          </ul>
          <button type="button" class="toggle" aria-pressed="true" data-mix-toggle disabled>60/40 line</button>
        </div>

        <div
          class="fcz"
          data-fcz
          tabindex="0"
          role="group"
          aria-label="Candlestick chart and excess strip. Use the left and right arrow keys to move between days."
        >
          {
            variants.map((v) => (
              <div
                class={`fcz-view ${v}`}
                data-variant={v}
                data-points={JSON.stringify(charts[v].points)}
                data-plot={JSON.stringify(charts[v].plot)}
                data-explot={JSON.stringify(charts[v].exPlot ?? null)}
                set:html={charts[v].svg + (charts[v].excess ?? '')}
              />
            ))
          }
        </div>

        <div class="fig-nav">
          <button type="button" class="step" data-step="-1" aria-label="Previous day" disabled>&larr;</button>
          <p class="readout" aria-live="polite" data-readout>{last.readout}</p>
          <button type="button" class="step" data-step="1" aria-label="Next day" disabled>&rarr;</button>
        </div>
        <dl class="day" aria-label="Selected day" data-day>
          <div><dt>Open</dt><dd data-f="o">{last.o.toFixed(2)}</dd></div>
          <div><dt>High</dt><dd data-f="h">{last.h.toFixed(2)}</dd></div>
          <div><dt>Low</dt><dd data-f="l">{last.l.toFixed(2)}</dd></div>
          <div><dt>Close</dt><dd data-f="c">{last.c.toFixed(2)}</dd></div>
          <div><dt>Day change</dt><dd data-f="chg">{(last.chg >= 0 ? '+' : '−') + Math.abs(last.chg).toFixed(2)}%</dd></div>
          <div><dt>SPY close</dt><dd data-f="spy">{last.spy.toFixed(2)}</dd></div>
          <div><dt>Bot minus SPY</dt><dd data-f="ex">{(last.ex >= 0 ? '+' : '−') + Math.abs(last.ex).toFixed(2)}</dd></div>
        </dl>
        <p class="foot" data-chart-foot>
          Index points, 100 on the first day. <span class="js-only">Click or touch the chart, use the arrows, or press the left and right arrow keys.</span>
        </p>
        <details class="table-view">
          <summary>Table view</summary>
          <div class="scroll" tabindex="0" role="region" aria-label="Chart values as a table" data-table-host set:html={charts.wide.table} />
        </details>
      </figure>

      <!-- Figure 2 -->
      <figure class="figure" id="figure-2">
        <figcaption class="cap">Figure 2 · Anatomy of a decision · An example, not a real decision</figcaption>
        <div class="anatomy">
          <pre class="code" tabindex="0" role="region" aria-label="Example model reply, as JSON"><code>{JSON.stringify(bot.exampleDecision, null, 2)}</code></pre>
          <ol class="flow">
            {
              bot.decisionFlow.map((f) => (
                <li>
                  <strong>{f.step}</strong>
                  <span>{f.text}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </figure>

      <h3 class="sub">Notes: what the bot may not do</h3>
      <ol class="rules">
        {controls.map((r) => <li>{r}</li>)}
      </ol>
    </section>

    <!-- Chapter 02 -->
    <section class="chapter" aria-labelledby="c2">
      <p class="kicker">Chapter 02</p>
      <h2 id="c2" class="chap">Other projects</h2>
      <ol class="projects">
        {
          others.map((p, i) => (
            <li class="proj">
              <div class="proj-meta">
                <p class="proj-no">{pad(i + 1)}</p>
                <p><span class={`status status-${p.status}`}>{statusWord[p.status]}</span></p>
                <p class="when">{opt(p, 'period') || p.statusLabel}</p>
              </div>
              <div class="proj-body">
                <h3 class="proj-title">{p.name}</h3>
                <p>{p.summary}</p>
                <ul class="stack" aria-label={`Stack of ${p.name}`}>
                  {p.stack.map((s) => <li>{s}</li>)}
                </ul>
                <p class="mini-link">
                  {p.repo ? <a href={p.repo} aria-label={`Source on GitHub: ${p.name}`}>Source on GitHub</a> : <span class="muted">No public repository</span>}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Chapter 03 -->
    <section class="chapter" aria-labelledby="c3">
      <p class="kicker">Chapter 03</p>
      <h2 id="c3" class="chap">The record</h2>
      <div class="record">
        <div class="block">
          <h3 class="sub">Experience</h3>
          <ul class="entries">
            {
              site.experience.map((e) => (
                <li>
                  <p class="when">{e.start} to {e.end}</p>
                  <p><strong>{e.role}</strong>, {e.org}{opt(e, 'place') && `, ${opt(e, 'place')}`}</p>
                  <p class="muted">{e.description}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="block">
          <h3 class="sub">Education</h3>
          <ul class="entries">
            {
              site.education.map((e) => (
                <li>
                  <p class="when">{e.period}</p>
                  <p><strong>{e.degree}</strong>, {e.school}{opt(e, 'place') && `, ${opt(e, 'place')}`}</p>
                </li>
              ))
            }
          </ul>
          <p class="muted small">Relevant coursework: {site.coursework.join(', ')}.</p>
          <h3 class="sub">Languages</h3>
          <p class="muted">{site.languages.map((l) => `${l.name} (${l.level})`).join(', ')}</p>
        </div>
      </div>

      <h3 class="sub">Tools, by how often they were used in something built</h3>
      <div class="skills">
        {
          skillGroups.map((g) => (
            <div>
              <h4>{g.group}</h4>
              <ul>
                {
                  g.skills.map((s) => (
                    <li>
                      {s.name} <span class="count" aria-label={`used in ${s.count} built ${s.count === 1 ? 'thing' : 'things'}`}>{s.count}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          ))
        }
      </div>
      <p class="muted small">Everything on the resume: {site.technicalSkills.join(', ')}.</p>
    </section>

    <!-- Footer of the letter -->
    <footer class="signoff">
      <p class="lic"><strong>Licenses.</strong> {licenseLine}.</p>
      <p class="buttons">
        <a class="btn btn-coral" href={site.links.github}>GitHub</a>
        <a class="btn btn-line" href={site.links.linkedin}>LinkedIn</a>
        {resume ? <a class="btn btn-solid" href={resume}>Resume (PDF)</a> : <span class="todo">resume: TODO</span>}
        {email && <a class="mail" href={`mailto:${email}`}>{email}</a>}
      </p>
    </footer>
  </div>
</FinanceLayout>

<script>
  import '../../scripts/bot-tiles';
  import '../../scripts/finance-live';
</script>
