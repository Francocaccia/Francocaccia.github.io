---
// Landing page. Composition only: every number, name and sentence comes from site.json or from the C++ core
// at build time. The scenes are decoration that moves with the scroll where the browser supports it, and
// finished still frames everywhere else (no JavaScript needed to read any of it).
import LandingLayout from '../layouts/LandingLayout.astro';
import Hero from '../components/landing/Hero.astro';
import Chapter from '../components/landing/Chapter.astro';
import SceneFinance from '../components/landing/SceneFinance.astro';
import SceneCode from '../components/landing/SceneCode.astro';
import SceneChain from '../components/landing/SceneChain.astro';
import SceneFlight from '../components/landing/SceneFlight.astro';
import Doors from '../components/landing/Doors.astro';
import ContactRow from '../components/landing/ContactRow.astro';
import MotionToggle from '../components/landing/MotionToggle.astro';
import { site, withBase } from '../lib/site';
import { enabledModes } from '../config';
import { previewCandles } from '../lib/charts';
import { personJsonLd } from '../lib/person-jsonld';
import { chainScene, codeExcerpt, financeScene, flightScene, metarPreview, terminalPreview } from '../lib/landing-data';

const modes = enabledModes();
const [finance, term, flight, doorCandles, chain] = await Promise.all([
  financeScene(),
  terminalPreview(modes.map((m) => m.id).filter((id) => id !== 'terminal')),
  flightScene(),
  previewCandles(240, 72, 11, 28),
  chainScene(),
]);
const code = codeExcerpt();
const metar = metarPreview();

const stat = (id: string) => {
  const h = site.highlights.find((x) => x.id === id);
  if (!h) throw new Error(`landing: no highlight "${id}" in site.json`);
  return { value: h.value, label: h.label };
};
const [atb, , defi, mev] = site.projects;
const firstSentence = (text: string) => text.split('. ')[0].replace(/\.$/, '') + '.';
const [w1, w2, w3] = site.finance.headline;
---

<LandingLayout title="Quant, software developer and pilot" description={`${site.name}: ${site.positioning} ${site.openTo}`}>
  <script type="application/ld+json" slot="head" set:html={personJsonLd()} />
  <script is:inline>
    document.documentElement.classList.add('js');
    try {
      if (localStorage.getItem('fc-motion') === 'off') document.documentElement.dataset.motion = 'off';
    } catch (e) {}
  </script>
  <div class="landing">
    <Hero />

    <section class="statement" id="story" aria-label="What I do">
      <p class="statement-words">
        <span class="w w1">{w1}</span>
        <span class="w w2">{w2}</span>
        <span class="w w3">{w3}</span>
      </p>
    </section>

    <Chapter
      scene="finance"
      id="ch-finance"
      kicker="01 · Finance"
      title={site.finance.quote}
      lede={`${firstSentence(atb.summary)} Benchmarked against the S&P 500 and a 60/40 portfolio, on paper only.`}
      stat={stat('fund-beta')}
      cta={{ href: withBase('/finance/'), label: 'Read the finance view', mode: 'finance' }}
    >
      <SceneFinance data={finance} />
    </Chapter>

    <Chapter
      scene="terminal"
      id="ch-code"
      kicker="02 · Code"
      title="Logic in C++, pages in Astro."
      lede="The pages are static. The logic behind them (a weather decoder, a chart engine, the shell in the terminal view) is C++ compiled to WebAssembly. What you see here is built from it."
      stat={stat('hours-saved')}
      cta={{ href: withBase('/terminal/'), label: 'Open the terminal view', mode: 'terminal' }}
    >
      <SceneCode code={code} term={term.projects} />
    </Chapter>

    <Chapter
      scene="chain"
      id="ch-crypto"
      kicker="03 · Crypto"
      title="Lending math, tested to 100% coverage."
      lede={`${firstSentence(defi.summary)} Below, a toy chain and a health-factor slider show the ideas, not a product.`}
      stat={stat('defi-coverage')}
      cta={{ href: defi.repo, label: 'See the lending protocol on GitHub', external: true }}
    >
      <SceneChain chain={chain} defiRepo={defi.repo} mev={{ name: mev.name, status: mev.statusLabel }} />
    </Chapter>

    <Chapter
      scene="aviation"
      id="ch-aviation"
      kicker="04 · Aviation"
      title="Route, weather and the math behind a flight."
      lede="Instrument-rated commercial pilot. This is the route on the Aviation page: Buenos Aires, Lynchburg, Lehigh Valley, as two great-circle legs."
      stat={stat('flight-hours')}
      cta={{ href: withBase('/aviation/'), label: 'Open the aviation view', mode: 'aviation' }}
    >
      <SceneFlight flight={flight} metar={metar} />
    </Chapter>

    <Doors candles={doorCandles.svg} about={term.about} metar={metar} />
    <ContactRow />
    <MotionToggle />
  </div>
</LandingLayout>

<script>
  import '../scripts/landing';
</script>
