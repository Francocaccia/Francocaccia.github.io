---
// "Ask the site": a bar with pre-written answers. It is not a chatbot and it makes nothing up: each answer is
// a paragraph built from site.json (src/lib/landing-faq.ts), and the bar only picks one by keywords. Without
// JavaScript the same answers are an ordinary list of questions that open and close.
import type { Answer } from '../../lib/landing-faq';

interface Props {
  answers: Answer[];
}

const { answers } = Astro.props;
---

<section class="ask" id="ask" aria-labelledby="ask-h" data-ask>
  <div class="ask-inner">
    <h2 id="ask-h">Ask me anything</h2>
    <p class="ask-lead">Pick a question or type your own. The answers are written in advance, and they come from the same data as everything else here.</p>

    <form class="ask-form" data-ask-form role="search">
      <label class="visually-hidden" for="ask-input">Your question</label>
      <input id="ask-input" type="text" data-ask-input autocomplete="off" spellcheck="false" maxlength="120" placeholder="Try: pilot, bot, resume, where he worked..." />
      <button type="submit" class="btn btn-primary">Ask</button>
    </form>

    <ul class="ask-chips" data-ask-chips>
      {answers.map((a) => <li><button type="button" class="chip" data-ask-q={a.id}>{a.question}</button></li>)}
    </ul>

    <div class="ask-out" data-ask-out role="region" aria-live="polite" aria-label="Answer">
      <p class="ask-hint">Pick a question above, or type your own.</p>
    </div>

    <div class="ask-list" data-ask-list>
      {
        answers.map((a) => (
          <details class="ask-item" data-ask-a={a.id} data-keys={a.keys}>
            <summary>{a.question}</summary>
            <div class="ask-a">
              <p>{a.text}</p>
              {
                a.links.length > 0 && (
                  <p class="ask-links">
                    {a.links.map((l) => (
                      <a class="btn" href={l.href} data-mode={l.mode} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener noreferrer' : undefined}>
                        {l.label}
                      </a>
                    ))}
                  </p>
                )
              }
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
