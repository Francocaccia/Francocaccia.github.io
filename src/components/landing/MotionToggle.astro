---
// Pause for anything that moves by itself for more than five seconds (WCAG 2.2.2). Hidden until the script
// runs; it sets html[data-motion="off"], which stops the marquee and the drifting background and turns the
// scroll effects into the finished still frames.
---

<button type="button" class="motion-toggle" data-motion-toggle aria-pressed="false" hidden>
  <span class="mt-label">Pause motion</span>
</button>
